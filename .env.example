# =====================================================================================
# Video Vault -- dashboard-only MVP. Everything below "Part 2" is optional.
# =====================================================================================

# --- Dashboard login (required to use the app at all) ---
#
# This app runs on a public URL once deployed, so without a password anyone who finds
# the domain could browse your download history. Pick any username/password.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Downloading ---

# Overall size ceiling (in MB) to compress a video down to.
MAX_MEDIA_MB=100

# Resolution to always target, regardless of what higher quality is available. Falls back to
# whatever's available if nothing at this height exists.
TARGET_HEIGHT=720

# Where downloaded/compressed files are temporarily stored before being served and cleaned up.
DOWNLOAD_DIR=downloads

# How long a downloaded video file is kept on disk (and servable/GIF-able) before being
# deleted. Thumbnails and GIFs outlive this -- see DASHBOARD_HISTORY_DAYS below.
FILE_TTL_MINUTES=60

# Server port (Railway sets PORT automatically; this is the local fallback).
PORT=3000

# Where job history (jobs.json) is stored.
DATA_DIR=data

# How long job history (link, thumbnail, GIFs, status) is kept after the video file
# itself has expired and been deleted.
DASHBOARD_HISTORY_DAYS=7

# Max clip length (seconds) allowed in a single GIF export. Longer clips at high fps get
# huge fast, so this is clamped server-side regardless of what the editor UI requests.
GIF_MAX_DURATION_SECONDS=15

# --- Reliability (see README "Improving reliability") ---

# Base64-encoded cookies.txt (Netscape format) exported from a logged-in browser.
# This is the single biggest lever for making LinkedIn/Instagram/Facebook/X links work
# reliably, since most failures are login walls, not missing yt-dlp support.
# Generate with: base64 -w0 cookies.txt   (macOS: base64 -i cookies.txt)
# COOKIES_BASE64=

# Alternative to COOKIES_BASE64: path to an existing cookies.txt file on disk.
# COOKIES_FILE=

# Mimic a real browser's TLS/HTTP fingerprint to dodge bot-detection (default: true).
IMPERSONATE_BROWSER=true

# How many extra attempts to make on transient failures (network hiccups, rate limits)
# before giving up. Login/removed/unsupported errors are never retried.
DOWNLOAD_RETRIES=2

# Max downloads/compressions to run at once. Keep this at 1 on small hosts (e.g. Railway's
# free tier) since ffmpeg compression is CPU-heavy; raise it only if your host has headroom.
MAX_CONCURRENT_JOBS=1

# =====================================================================================
# Part 2 (optional): WhatsApp via Twilio
# Leave every var in this section unset and the app runs as a dashboard-only video vault
# -- the /whatsapp/webhook route stays disabled. Set ALL of the TWILIO_* vars to turn it on.
# =====================================================================================

# Twilio credentials (Console -> Account Info)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token

# The WhatsApp-enabled Twilio number that sends replies, e.g. whatsapp:+14155238886
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Public HTTPS base URL of this deployment, no trailing slash -- required for WhatsApp
# since Twilio has to fetch media from an absolute, publicly reachable URL. Not needed
# for dashboard-only use (it just falls back to relative URLs).
# On Railway this is your generated domain, e.g. https://your-app.up.railway.app
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Comma-separated list of WhatsApp numbers allowed to use the bot (E.164, prefixed with "whatsapp:").
# ALLOWED_WHATSAPP_NUMBERS=whatsapp:+15551234567

# WhatsApp's own hard limit for a playable inline video message -- this is enforced by
# WhatsApp/Twilio, not this app, so raising it won't make larger videos playable inline.
# Videos under this size are sent as a normal video message; videos over it (up to
# MAX_MEDIA_MB) are sent as a download link instead, since WhatsApp would reject them.
WHATSAPP_INLINE_VIDEO_MB=16

# Set to "false" to skip Twilio request-signature validation (useful for local testing only).
VALIDATE_TWILIO_SIGNATURE=true

# How long to remember a Twilio MessageSid to ignore webhook retries for the same inbound
# message (which would otherwise trigger a duplicate download).
DEDUPE_TTL_MINUTES=30
